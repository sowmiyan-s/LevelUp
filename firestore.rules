rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.dailyTargetMinutes is int && data.dailyTargetMinutes >= 30 && data.dailyTargetMinutes <= 960 &&
             data.streakFreezes is int && data.streakFreezes >= 0 && data.streakFreezes <= 20 &&
             data.shieldedApps is list && data.shieldedApps.size() <= 20 &&
             (data.shieldedApps.size() == 0 || (data.shieldedApps[0] is string && data.shieldedApps[0].size() <= 40)) &&
             data.darkModeEnabled is bool &&
             data.hapticsEnabled is bool;
    }

    function isValidGoal(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidDateKey(data.dateKey) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.targetMinutes is int && data.targetMinutes >= 5 && data.targetMinutes <= 600 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.tier in ['ESSENTIAL', 'OPTIONAL'] &&
             data.completed is bool;
    }

    function isValidSession(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidDateKey(data.dateKey) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.startMinuteOfDay is int && data.startMinuteOfDay >= 0 && data.startMinuteOfDay <= 1439 &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 720 &&
             data.tags is list && data.tags.size() <= 8 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 30)) &&
             data.subNotes is string && data.subNotes.size() <= 2000 &&
             (!('goalId' in data) || (data.goalId is string && isValidId(data.goalId))) &&
             data.shieldActive is bool;
    }

    function isValidDayStatus(data, userId, dateKey) {
      return data.userId is string && data.userId == userId &&
             isValidDateKey(data.dateKey) && data.dateKey == dateKey &&
             data.freezeUsed is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'dailyTargetMinutes', 'streakFreezes', 'shieldedApps', 'darkModeEnabled', 'hapticsEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'dailyTargetMinutes', 'streakFreezes', 'shieldedApps', 'darkModeEnabled', 'hapticsEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'dailyTargetMinutes', 'streakFreezes', 'shieldedApps', 'darkModeEnabled', 'hapticsEnabled', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(goalId) &&
                         incoming().keys().hasAll(['userId', 'dateKey', 'title', 'targetMinutes', 'category', 'tier', 'completed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dateKey', 'title', 'targetMinutes', 'category', 'tier', 'completed', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidGoal(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(goalId) &&
                         isValidGoal(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['dateKey', 'title', 'targetMinutes', 'category', 'tier', 'completed', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll(['userId', 'dateKey', 'title', 'category', 'startMinuteOfDay', 'durationMinutes', 'tags', 'subNotes', 'shieldActive', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dateKey', 'title', 'category', 'startMinuteOfDay', 'durationMinutes', 'tags', 'subNotes', 'goalId', 'shieldActive', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidSession(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidSession(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'startMinuteOfDay', 'durationMinutes', 'tags', 'subNotes', 'goalId', 'shieldActive', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /dayStatuses/{dateKey} {
        allow get: if isOwner(userId) && isValidDateKey(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         incoming().keys().hasAll(['userId', 'dateKey', 'freezeUsed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dateKey', 'freezeUsed', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidDayStatus(incoming(), userId, dateKey);

        allow update: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         isValidDayStatus(incoming(), userId, dateKey) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['freezeUsed', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidDateKey(dateKey);
      }
    }
  }
}
